  "bands": [
    {"species": "CO₂",                "group": "co2",          "pair": 1,  "is_overtone": true,  "vibration": "combination",  "atoms": "O=C=O", "wn_start": 3725, "wn_end": 3735, "region": "high",   "short": "ν<sub>s</sub>+ν<sub>as</sub>(OCO) CO₂ (R)",         "description": "Gas CO₂ combination band at ~3730 cm⁻¹; (ν₁ + ν₃) R-branch — upper Fermi-resonance component, R-side. Useful for high-pressure quantification when the ν_as fundamental saturates."},
    {"species": "CO₂",                "group": "co2",          "pair": 1,  "is_overtone": true,  "vibration": "combination",  "atoms": "O=C=O", "wn_start": 3695, "wn_end": 3705, "region": "high",   "short": "ν<sub>s</sub>+ν<sub>as</sub>(OCO) CO₂ (P)",         "description": "Gas CO₂ combination band at ~3699 cm⁻¹; (ν₁ + ν₃) P-branch — upper Fermi-resonance component, P-side. P/R-branch separation ~30 cm⁻¹; pair-mate of the R-branch at ~3730."},
    {"species": "CO₂",                "group": "co2",          "pair": 1,  "is_overtone": true,  "vibration": "combination",  "atoms": "O=C=O", "wn_start": 3622, "wn_end": 3632, "region": "high",   "short": "2δ+ν<sub>as</sub>(OCO) CO₂ (R)",                    "description": "Gas CO₂ combination band at ~3627 cm⁻¹; (2ν₂ + ν₃) R-branch — lower Fermi-resonance component, R-side. Separation between Fermi pair (3730 vs 3627) ~107 cm⁻¹ is fixed."},
    {"species": "CO₂",                "group": "co2",          "pair": 1,  "is_overtone": true,  "vibration": "combination",  "atoms": "O=C=O", "wn_start": 3592, "wn_end": 3602, "region": "high",   "short": "2δ+ν<sub>as</sub>(OCO) CO₂ (P)",                    "description": "Gas CO₂ combination band at ~3597 cm⁻¹; (2ν₂ + ν₃) P-branch — lower Fermi-resonance component, P-side. P/R-branch separation ~30 cm⁻¹; pair-mate of the R-branch at ~3627."},
    {"species": "CO₂",                "group": "co2",          "pair": 1,  "is_overtone": false, "vibration": "asym stretch", "atoms": "O=C=O", "wn_start": 2300, "wn_end": 2400, "region": "mid_hi", "short": "ν<sub>as</sub>(OCO) CO₂",                           "description": "Gas CO₂ antisymmetric stretch (ν₃); P/R branches at ~2349 cm⁻¹; saturates at high pressure."},
    {"species": "CO₂",                "group": "co2",          "pair": 1,  "is_overtone": false, "vibration": "bending",      "atoms": "O=C=O", "wn_start": 690,  "wn_end": 720,  "region": "low",    "short": "δ(OCO) CO₂ (R)",                                    "description": "Gas CO₂ bending fundamental (ν₂) — R-branch (ΔJ = +1) at ~700 cm⁻¹. Higher-frequency rotational envelope; pair-mate of the P-branch at ~660. Q-branch is allowed (Σ→Π transition) and appears as a sharp spike at ~667 between P and R envelopes."},
    {"species": "CO₂",                "group": "co2",          "pair": 1,  "is_overtone": false, "vibration": "bending",      "atoms": "O=C=O", "wn_start": 670,  "wn_end": 685,  "region": "low",    "short": "δ(OCO) CO₂ (Q)",                                    "description": "Gas CO₂ bending fundamental (ν₂) — Q-branch (ΔJ = 0) at ~667 cm⁻¹. Sharp, intense spike between P and R envelopes; allowed because ν₂ is a Σ→Π (perpendicular) transition. Saturates very quickly at modest pCO₂."},
    {"species": "CO₂",                "group": "co2",          "pair": 1,  "is_overtone": false, "vibration": "bending",      "atoms": "O=C=O", "wn_start": 640,  "wn_end": 665,  "region": "low",    "short": "δ(OCO) CO₂ (P)",                                    "description": "Gas CO₂ bending fundamental (ν₂) — P-branch (ΔJ = −1) at ~660 cm⁻¹. Lower-frequency rotational envelope; pair-mate of the R-branch at ~700. Atmospheric CO₂ in the beam path contributes to this region; routinely seen even with good purging."},

    {"species": "CO",                 "group": "co",           "pair": 1,  "is_overtone": false, "vibration": "stretch",      "atoms": "C-O",   "wn_start": 2165, "wn_end": 2185, "region": "mid_hi", "short": "ν(CO) CO (R)",                                      "description": "Gas-phase CO antisymmetric stretch — R-branch (ΔJ = +1) at ~2170 cm⁻¹. Higher-frequency rotational envelope; pair-mate of the P-branch at ~2115. Q-branch forbidden for diatomic CO, leaving a characteristic gap at ~2143 between R and P branches."},
    {"species": "CO",                 "group": "co",           "pair": 1,  "is_overtone": false, "vibration": "stretch",      "atoms": "C-O",   "wn_start": 2105, "wn_end": 2125, "region": "mid_hi", "short": "ν(CO) CO (P)",                                      "description": "Gas-phase CO antisymmetric stretch — P-branch (ΔJ = −1) at ~2115 cm⁻¹. Lower-frequency rotational envelope; pair-mate of the R-branch at ~2170. P/R splitting ~55 cm⁻¹ at room temperature, broadens with temperature."},

    {"species": "CH₄",                "group": "ch4",          "pair": 1,  "is_overtone": false, "vibration": "asym stretch", "atoms": "H-C-H", "wn_start": 2980, "wn_end": 3060, "region": "high",   "short": "ν<sub>as</sub>(HCH) CH₄(g)",                        "description": "Gas methane antisymmetric C-H stretch (ν₃, T₂ mode); sharp Q-branch at ~3019 cm⁻¹ with rotational P/R structure."},
    {"species": "CH₄",                "group": "ch4",          "pair": 1,  "is_overtone": false, "vibration": "bending",      "atoms": "H-C-H", "wn_start": 1280, "wn_end": 1340, "region": "mid",    "short": "δ<sub>as</sub>(HCH) CH₄(g)",                        "description": "Gas methane antisymmetric bending (ν₄, T₂ mode) at ~1306 cm⁻¹."},
    {"species": "CH₄",                "group": "ch4",          "pair": 1,  "is_overtone": true,  "vibration": "combination",  "atoms": "H-C-H", "wn_start": 4180, "wn_end": 4250, "region": "high",   "short": "δ<sub>s</sub>+ν<sub>as</sub>(HCH) CH₄(g)",          "description": "Gas methane combination band at ~4220 cm⁻¹; useful for high-pressure quantification when ν_as saturates. Often outside standard DRIFTS window."},
    {"species": "CH₄*",          "group": "ch4",          "pair": 1,  "is_overtone": false, "vibration": "asym stretch", "atoms": "H-C-H", "wn_start": 2950, "wn_end": 3020, "region": "high",   "short": "ν<sub>as</sub>(HCH) CH₄*",                          "description": "Physisorbed methane (CH₄*) on the catalyst surface; red-shifted from gas-phase by 10-30 cm⁻¹. Asterisk denotes surface adsorption."},

    {"species": "CO/Cu0",                "group": "co_metal",         "pair": 2,  "is_overtone": false, "vibration": "stretch",      "atoms": "C-O",   "wn_start": 2080, "wn_end": 2100, "region": "mid_hi", "short": "ν(CO) CO/Cu⁰",                                            "description": "CO adsorbed on metallic Cu(0); oxidation-state probe. Asterisk denotes surface adsorption."},
    {"species": "CO/Cu+",                "group": "co_metal",         "pair": 2,  "is_overtone": false, "vibration": "stretch",      "atoms": "C-O",   "wn_start": 2100, "wn_end": 2130, "region": "mid_hi", "short": "ν(CO) CO/Cu⁺",                                            "description": "CO adsorbed on Cu(I) sites. Asterisk denotes surface adsorption."},
    {"species": "CO/Cu2+",               "group": "co_metal",         "pair": 2,  "is_overtone": false, "vibration": "stretch",      "atoms": "C-O",   "wn_start": 2150, "wn_end": 2180, "region": "mid_hi", "short": "ν(CO) CO/Cu²⁺",                                           "description": "CO adsorbed on Cu(II) sites. Asterisk denotes surface adsorption."},
    {"species": "CO linear (μ₁)",        "group": "co_metal",         "pair": 2,  "is_overtone": false, "vibration": "stretch",      "atoms": "C-O",   "wn_start": 2000, "wn_end": 2120, "region": "mid_hi", "short": "ν(CO) linear (μ₁)",                                 "description": "Linear (atop) CO bonded to a single metal atom. Most common mode on Cu, Pt, Pd, Rh, Ni, Co. Position shifts with metal (Cu ~2080, Pt ~2070, Rh ~2050) and oxidation state. Coverage-sensitive due to dipole-dipole coupling. Asterisk denotes surface adsorption."},
    {"species": "CO bridge (μ₂)",        "group": "co_metal",         "pair": 2,  "is_overtone": false, "vibration": "stretch",      "atoms": "C-O",   "wn_start": 1820, "wn_end": 1980, "region": "mid",    "short": "ν(CO) bridge (μ₂)",                                 "description": "Bridging CO between two metal atoms. Lower frequency due to back-donation from two metals into CO π*. Common on Pt, Pd (often dominant), Rh, Ni; rare on Cu (only at high coverage). Diagnostic of step/edge sites."},
    {"species": "CO 3-fold hollow (μ₃)", "group": "co_metal",         "pair": 2,  "is_overtone": false, "vibration": "stretch",      "atoms": "C-O",   "wn_start": 1750, "wn_end": 1870, "region": "mid",    "short": "ν(CO) 3-fold (μ₃)",                                 "description": "Three-fold hollow (face-capping) CO bonded to three metal atoms. Common on Pd(111), Pt(111), Rh terraces. Rare on Cu, Co. Strongest at high coverage."},
    {"species": "CO 4-fold hollow (μ₄)", "group": "co_metal",         "pair": 2,  "is_overtone": false, "vibration": "stretch",      "atoms": "C-O",   "wn_start": 1600, "wn_end": 1700, "region": "mid",    "short": "ν(CO) 4-fold (μ₄)",                                 "description": "Four-fold hollow CO bonded to four metals. Rare; reported on Ni(100) and certain Co surfaces. Lowest frequency of all metal-CO modes."},

    {"species": "CO/cation site",        "group": "co_cation",        "pair": 3,  "is_overtone": false, "vibration": "stretch",      "atoms": "C-O",   "wn_start": 2120, "wn_end": 2230, "region": "mid_hi", "short": "ν(CO)/Mⁿ⁺",                                          "description": "Linear CO on Lewis-acidic metal cation sites of oxide supports. Higher frequency than CO on reduced metals (~2120-2230). Position depends on cation: Ce³⁺ ~2130, Ce⁴⁺ ~2160, Ti⁴⁺ ~2190, Zn²⁺ ~2200, Al³⁺/Mg²⁺ ~2210. Useful Lewis-acidity probe."},
    {"species": "CO isocarbonyl",        "group": "co_cation",        "pair": 3,  "is_overtone": false, "vibration": "stretch",      "atoms": "C-O",   "wn_start": 2200, "wn_end": 2240, "region": "mid_hi", "short": "ν(CO) iso (M-OC)",                                  "description": "Isocarbonyl: CO bonded through oxygen instead of carbon. Rare; reported on highly oxidized supports and certain zeolite cations. Higher frequency than C-bonded CO."},
    {"species": "CO gem-dicarbonyl",     "group": "co_cation",        "pair": 3,  "is_overtone": false, "vibration": "asym stretch", "atoms": "C-O",   "wn_start": 2080, "wn_end": 2110, "region": "mid_hi", "short": "ν<sub>as</sub>(CO) gem-M⁺(CO)₂",                    "description": "Antisymmetric component of gem-dicarbonyl: two linear COs on a single isolated cation site (typically Rh⁺, Ir⁺, Ru⁺). The sym/asym pair is diagnostic of atomically-dispersed cations. Splitting ~50-60 cm⁻¹."},
    {"species": "CO gem-dicarbonyl",     "group": "co_cation",        "pair": 3,  "is_overtone": false, "vibration": "sym stretch",  "atoms": "C-O",   "wn_start": 2020, "wn_end": 2050, "region": "mid_hi", "short": "ν<sub>s</sub>(CO) gem-M⁺(CO)₂",                     "description": "Symmetric component of gem-dicarbonyl pair. Pairs with asymmetric component to identify isolated cation sites."},

