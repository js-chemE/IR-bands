// =============================================================================
// Tag tooltips — short, human-readable descriptions of every tag used
// elsewhere in this dataset (band-level tags, per-citation reference tags,
// and vibration-mode tags in vibrations.jsonc).
// -----------------------------------------------------------------------------
// This file is JSONC (JSON with Comments). The build step strips // and /* */
// comments before shipping clean JSON to the browser.
//
// IMPORTANT — keep this in sync: whenever a tag is introduced, renamed, or
// retired anywhere in bands.jsonc/vibrations.jsonc, add/update/remove its
// entry here in the same change. See CLAUDE.md.
//
// This file does not gate which tags are *allowed* — tags stay free-form,
// authored directly in bands.jsonc/vibrations.jsonc. This is purely a
// lookup table for display: any tag without an entry here just renders
// without a tooltip in the frontend (Object.lookup, not a fixed enum).
//
// Schema:
//   tags        — object keyed by the exact tag string as it appears in the
//                 data (e.g. "site-sensitive"). Each value is an object:
//                   tip — one short sentence, shown as a tooltip wherever
//                         this tag renders as a chip (currently: the tag
//                         selector in the band chart's legend; may extend
//                         to other tag chips — ReferencesPage, vibration-
//                         modes page — later without a schema change).
// -----------------------------------------------------------------------------
{
  "tags": {
    "combination": {
      "tip": "Auto-tagged: this band is a combination (sum) mode, not a fundamental."
    },
    "computational": {
      "tip": "A calculation rather than a measured spectrum. On one claim it says that claim is calculated (e.g. DFT); on a band it is auto-tagged and says every claim behind it is, with no measurement at all. Not the same as unreferenced, where nothing has been recorded; the chart fades the two from separate switches so you can ask for measured evidence alone."
    },
    "degenerated": {
      "tip": "Two or more vibrational modes coincide at the same frequency and share one observed band."
    },
    "direct-dosing": {
      "tip": "Species generated by dosing/adsorbing its own desorbed counterpart directly (e.g. formate from formic acid), not via a genuine surface reaction."
    },
    "ftir": {
      "tip": "The source says only that it used FTIR, which names the interferometer rather than the sampling geometry."
    },
    "drifts": {
      "tip": "Measured by diffuse reflectance infrared spectroscopy (DRIFTS)."
    },
    "raman": {
      "tip": "A Raman shift rather than an infrared absorption: the same vibrational energy, seen through the polarizability rather than the dipole. Greyed out and folded in the chart while it is set to IR."
    },
    "irras": {
      "tip": "Measured by infrared reflection absorption spectroscopy: grazing incidence off a flat, usually single-crystal sample in vacuum. The surface selection rule applies, so only dipole components along the surface normal absorb and a missing band may mean a mode lying flat rather than a species that is absent."
    },
    "pm_irras": {
      "tip": "IRRAS with the polarisation modulated between s and p, which subtracts the isotropic gas-phase and window background and lets reflection measurements work outside vacuum."
    },
    "emission": {
      "tip": "The hot sample is the infrared source rather than something the beam passes through; used where a bed is too opaque or too hot for the other geometries."
    },
    "fermi-resonance": {
      "tip": "Auto-tagged: this band is one half of a Fermi-resonance doublet with another band."
    },
    "frustrated-mode": {
      "tip": "A free gas-phase rotation/translation that becomes a restoring-force vibration once the molecule is adsorbed."
    },
    "fundamental": {
      "tip": "Auto-tagged: the v = 0 → 1 transition of a normal mode, the first step rather than a multiple or a sum. A rotational branch is still a fundamental, and so is an IR-inactive mode."
    },
    "transmission": {
      "tip": "Measured in transmission through a self-supporting wafer, rather than by diffuse reflectance."
    },
    "gas-phase": {
      "tip": "Band belongs to a gas-phase species, not an adsorbed one."
    },
    "gas": {
      "tip": "Auto-tagged from the claim's state: this measurement was made on the free molecule in a cell. Not the same as the band-level \"gas-phase\", which says the band belongs to a free molecule wherever it is seen; this says how this one sample was held."
    },
    "liquid": {
      "tip": "Auto-tagged from the claim's state: measured on the neat liquid or a solution. Hydrogen-bonded positions shift by tens of cm⁻¹ from the vapour, and there is no rotational structure, so a liquid value is not a free-molecule value."
    },
    "matrix": {
      "tip": "Auto-tagged from the claim's state: the molecule isolated in a frozen noble gas (neon or argon) at a few K. Effectively the free molecule with its rotation quenched, but the host still shifts the position by a few to twenty cm⁻¹, and neon and argon disagree with each other."
    },
    "solid": {
      "tip": "Auto-tagged from the claim's state: measured on the bulk solid substance itself, crystalline or amorphous, rather than on isolated molecules."
    },
    "adsorbed": {
      "tip": "Auto-tagged from the claim's state: this measurement was made on the species bound to a surface. Which surface is in the claim's own site badge. It says nothing about whether the species adsorbed intact or as a fragment; that is the band-level \"undissociated\"."
    },
    "ir-active": {
      "tip": "This vibrational mode is IR-allowed."
    },
    "ir-inactive": {
      "tip": "Symmetry-forbidden in IR; included for context even though not directly observed. Drawn hollow when the chart is set to IR."
    },
    "isotope-labeling": {
      "tip": "This source used isotope substitution as evidence for the assignment (the band itself is the ordinary, natural-abundance one)."
    },
    "isotope": {
      "tip": "This band is a labelled twin of another band in the atlas rather than the ordinary molecule. The tag beside it says which substitution."
    },
    "carbon-13": {
      "tip": "This band is the ¹³C-substituted twin of another band in the atlas, not the ordinary molecule."
    },
    "oxygen-18": {
      "tip": "This band is the ¹⁸O-substituted twin of another band in the atlas, not the ordinary molecule."
    },
    "deuterium": {
      "tip": "This band is the deuterated twin of another band in the atlas: same mode, heavier hydrogen. Drawn hatched."
    },
    "to-be-revised": {
      "tip": "Something on this band does not add up and has not been resolved yet: a claim that may sit on the wrong band, or an assignment that needs the source read again. Not a caveat about the chemistry, a note that the entry itself is unfinished."
    },
    "misassignment-warning": {
      "tip": "A known trap: this position is easily assigned to the wrong species, or read as a surface signal when it is not one (gas-phase absorption in the beam path)."
    },
    "undissociated": {
      "tip": "The species sits on the surface intact rather than broken into a fragment: adsorbed methanol CH₃OH* as against the methoxy CH₃O* it dissociates into. That is a property of the species wherever it is seen, so it is a band tag. Not the same as the per-claim \"adsorbed\", which only says one measurement was made on a surface: every methoxy claim is adsorbed, and methoxy is not undissociated."
    },
    "overtone": {
      "tip": "Band is an overtone of a lower fundamental, not the fundamental itself."
    },
    "raman-active": {
      "tip": "This vibrational mode is Raman-allowed."
    },
    "raman-inactive": {
      "tip": "Forbidden in Raman: the vibration leaves the polarizability unchanged (for gas CO₂, every infrared band, by the mutual exclusion rule), or, for a linear molecule's P and R branches, the rotational change is one Raman does not allow. Drawn hollow when the chart is set to Raman."
    },
    "rotational-branches": {
      "tip": "Auto-tagged: one rotational branch (P/Q/R) of a multi-branch transition; see its sibling branches."
    },
    "site-sensitive": {
      "tip": "Band position shifts meaningfully with adsorption site or surface composition."
    }
  }
}
