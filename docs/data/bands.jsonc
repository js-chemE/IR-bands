    // see ADSORBED WATER below for the broadened, merged surface-phase bands.
    // ---------------------------------------------------------------------------
    {
      "id": "h2og_sym",
      "species": "water",
      "phase": "gas",
      "group": "water",
      "vibration_modes": ["h2o_stretch_symmetric"],
      "vibration": {
        "category": "stretch",
        "subtype": "symmetric",
        "branch": null
      },
      "atoms": "H-O-H",
      "wn_start": 3650,
      "wn_end": 3660,
      "short": "νₛ(HOH) H₂O",
      "description": "Gas-phase water symmetric O-H stretch (ν₁, A₁): both O-H bonds lengthening and shortening together, in phase. The number is the band origin, not the feature you see. Water is a light asymmetric top with widely spaced rotational levels, so each fundamental is a rovibrational envelope hundreds of cm⁻¹ across, built from sharp individual lines: the sharpness belongs to the lines, the band is wide. It overlaps ν₃ throughout, and the two are separable only by line position. Adsorbed or condensed water loses the rotation and gives one broad merged feature instead (see oh_surface).",
      "based_on": [],
      "references": [
        {
          "key": "Shimanouchi.TablesMolecularVibrational.1972",
          "wn": 3657,
          "technique": "transmission",
          "state": "gas",
          "note": "Table No. 4, water H₂O, C₂ᵥ: selected value 3657 cm⁻¹ for ν₁ sym stretch, with uncertainty code A, the compilation's best grade at 0 to 1 cm⁻¹. The gas-phase infrared column gives 3656.65 cm⁻¹. The Raman column gives 3654 cm⁻¹ for the same mode.",
          "tags": []
