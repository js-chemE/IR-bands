    {
      "id": "ch4g_asym_o",
      "species": "ch4",
      "phase": "gas",
      "group": "ch4",
      "vibration": {
        "category": "stretch",
        "subtype": "asymmetric",
        "branch": "O"
      },
      "branch_group": "ch4_nu3_branches",
      "atoms": "H-C-H",
      "wn_start": 2862,
      "wn_end": 2988,
      "short": "νₐₛ(HCH) CH₄",
      "description": "The O branch of ν₃ (F₂), the pentad, ΔJ = −2, reaching below the band centre. Methane is a spherical top, and for its degenerate vibrations Raman reaches ΔJ = 0, ±1 and ±2, so this transition carries all five branches rather than the three an infrared band would show. The O branch steps by 4B against 2B for P, so it reaches roughly twice as far out.24 cm⁻¹ and the levels populated at room temperature, not a reported position. A spherical top gives fifteen branches in all once the Coriolis sublevels are counted, and they are not equal: S and R carry considerably more intensity than O and P, with S⁺, Q⁰ and O⁻ the strongest of them.",
      "based_on": [],
      "references": [
        {
          "key": "Jourdanneau.MethaneRamanSpectrum.2005",
          "technique": "raman",
          "laser_nm": 515,
          "state": "gas",
          "tags": [],
          "note": "Sect. 4.2, Fig. 3 and Fig. 13: the rotational structure either side of the sharp Q branch of ν₃ (F₂), the pentad. The paper names neither the branches nor their positions, so nothing is recorded as a position here. The O branch is carried because a spherical top allows it: the wing on this side holds O lines as well as P, and the earlier reading of that wing as P alone named only the nearer half. Spontaneous Raman of ¹²CH₄ in a gas cell at about one amagat, 4 W argon-ion laser. Laser line assumed, not reported: 515 nm is the strongest green argon-ion line."
        }
      ],
      "intensity": "w",
      "width": "broad",
      "confidence": "likely",
      "tags": ["degenerated", "ir-inactive"]
    },
