        {
          "key": "Gomez.InterdependenceExtentGa.2024",
          "wn": 2919,
          "site": "Cu⁺",
          "note": "ν_as(CH₃) on Cu⁺ at Cu–Ga₂O₃; downshifted from ~2926 cm⁻¹ on unpromoted Cu/SiO₂ — diagnostic of the Ga promoter-induced site change."
        },
        {
          "key": "AlAbdulghani.UncoveringPressureDependentMechanism.2025",
          "wn": 2970,
          "site": "Zr⁴⁺",
          "note": "ν_as(CH₃) at 2970 cm⁻¹ on Zr⁴⁺ sites of Zr-rich CuGaZrOx."
        }
