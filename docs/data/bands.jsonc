      },
      "atoms": "C-O",
      "wn_start": 2000,
      "wn_end": 2120,
      "short": "ν(CO) linear (μ₁)",
      "description": "Linear (atop) CO bonded to a single metal atom. Most common adsorption mode on Cu, Pt, Pd, Rh, Ni, and Co surfaces. Frequency depends on metal identity, oxidation state, coordination environment, and surface coverage due to π-backdonation and dipole coupling. Typical values: Cu⁰ ~2080–2100, Pt ~2070, Rh ~2050 cm⁻¹. Electron-poor or partially oxidized sites shift to higher frequency.",
      "based_on": [],
      "references": [
        {
          "key": "Paredes-Nunez.SpectrumBaselineArtefacts.2015",
          "wn": 2041,
          "site": "Co⁰",
          "note": "Linear (on-top) CO on metallic Co at 2041 cm⁻¹ (Fig. 5a, Section 3.3). 14% Co/Siralox shows cobalt carbonyl signal spanning 2100–1700 cm⁻¹ with maximum at ~2059 cm⁻¹ (Fig. 4c, Section 3.2). Gas-phase CO R/P branches at 2176/2114 cm⁻¹ are simultaneously visible and must be subtracted; ill-resolved bridged/multibonded CO bands appear below 2000 cm⁻¹."
        },
        {
          "key": "VicovanBerkel.ExploitingContinuityEquation.2024",
          "wn": 2053,
          "site": "Pt⁰-CeO₂ interface",
          "note": "Linear ¹²CO on Pt at the Pt–CeO₂ interface at 2053 cm⁻¹ (Fig. 4a); red-shifted by ~20–30 cm⁻¹ from bare Pt (2070–2080 cm⁻¹) due to enhanced π-backdonation from highly reduced CeO₂. SSITKA confirms this species is an active intermediate in RWGS: isotopic exchange rate matches CO(g) production rate. Under ¹³CO₂ a further red-shift to 2005 cm⁻¹ is observed, consistent with the expected isotopic shift for a linear CO stretch.",
          "tags": ["isotopic-shift"]
        }
      ],
      "intensity": "s",
      "width": "medium",
      "confidence": "confirmed",
      "tags": []
    },
