// =============================================================================
// Tag tooltips — short, human-readable descriptions of every tag used
// elsewhere in this dataset (band-level tags, per-citation reference tags,
// and vibration-mode tags in vibrations.jsonc).
// -----------------------------------------------------------------------------
// This file is JSONC (JSON with Comments). The build step strips // and /* */
// comments before shipping clean JSON to the browser.
//
// IMPORTANT — keep this in sync: whenever a tag is introduced, renamed, or
// retired anywhere in bands.jsonc/vibrations.jsonc, add/update/remove its
// entry here in the same change. See CLAUDE.md.
//
// This file does not gate which tags are *allowed* — tags stay free-form,
// authored directly in bands.jsonc/vibrations.jsonc. This is purely a
// lookup table for display: any tag without an entry here just renders
// without a tooltip in the frontend (Object.lookup, not a fixed enum).
//
// Schema:
//   tags        — object keyed by the exact tag string as it appears in the
//                 data (e.g. "site-sensitive"). Each value is an object:
//                   tip — one short sentence, shown as a tooltip wherever
//                         this tag renders as a chip (currently: the tag
//                         selector in the band chart's legend; may extend
//                         to other tag chips — ReferencesPage, vibration-
//                         modes page — later without a schema change).
// -----------------------------------------------------------------------------
{
  "tags": {
    "combination": {
      "tip": "Auto-tagged: this band is a combination (sum) mode, not a fundamental."
    },
    "computational": {
      "tip": "Assignment or frequency comes from a calculation (e.g. DFT), not a measured spectrum."
    },
    "degenerated": {
      "tip": "Two or more vibrational modes coincide at the same frequency and share one observed band."
    },
    "direct-dosing": {
      "tip": "Species generated by dosing/adsorbing its own desorbed counterpart directly (e.g. formate from formic acid), not via a genuine surface reaction."
    },
    "ftir": {
      "tip": "The source says only that it used FTIR, which names the interferometer rather than the sampling geometry."
    },
    "drifts": {
      "tip": "Measured by diffuse reflectance infrared spectroscopy (DRIFTS)."
    },
    "fermi-resonance": {
      "tip": "Auto-tagged: this band is one half of a Fermi-resonance doublet with another band."
    },
    "frustrated-mode": {
      "tip": "A free gas-phase rotation/translation that becomes a restoring-force vibration once the molecule is adsorbed."
    },
    "transmission": {
      "tip": "Measured in transmission through a self-supporting wafer, rather than by diffuse reflectance."
    },
    "gas-phase": {
      "tip": "Band belongs to a gas-phase species, not an adsorbed one."
    },
    "ir-active": {
      "tip": "This vibrational mode is IR-allowed."
    },
    "ir-inactive": {
      "tip": "Symmetry-forbidden in IR; included for context even though not directly observed."
    },
    "isotope-labeling": {
      "tip": "This source used isotope substitution as evidence for the assignment (the band itself is the ordinary, natural-abundance one)."
    },
    "isotope": {
      "tip": "This band is a labelled twin of another band in the atlas rather than the ordinary molecule. The tag beside it says which substitution."
    },
    "carbon-13": {
      "tip": "This band is the ¹³C-substituted twin of another band in the atlas, not the ordinary molecule."
    },
    "oxygen-18": {
      "tip": "This band is the ¹⁸O-substituted twin of another band in the atlas, not the ordinary molecule."
    },
    "deuterium": {
      "tip": "This band is the deuterated twin of another band in the atlas: same mode, heavier hydrogen. Drawn hatched."
    },
    "misassignment-warning": {
      "tip": "A known trap: this position is easily assigned to the wrong species, or read as a surface signal when it is not one (gas-phase absorption in the beam path)."
    },
    "molecular-adsorption": {
      "tip": "Species is adsorbed intact (not dissociated) rather than as a surface fragment."
    },
    "overtone": {
      "tip": "Band is an overtone of a lower fundamental, not the fundamental itself."
    },
    "raman-active": {
      "tip": "This vibrational mode is Raman-allowed."
    },
    "rotational-branches": {
      "tip": "Auto-tagged: one rotational branch (P/Q/R) of a multi-branch transition; see its sibling branches."
    },
    "site-sensitive": {
      "tip": "Band position shifts meaningfully with adsorption site or surface composition."
    }
  }
}
