    }
  },

  // ---------------------------------------------------------------------------
  // Lanes — the chart's rows, top to bottom.
  // Each entry names the groups that share one row; two groups share a lane
  // only when they read as one family on screen, which is rarer than it
  // sounds: methoxy and the methanol it converts into shared one until their
  // bands had to be told apart. This replaced a per-band `pair` integer that
  // said the same thing 92 times over, and it makes the row ORDER editable
  // instead of falling out of the numbering.
  //
  // Every group in the table above must appear in exactly one lane; build.py
  // checks it. A lane whose groups are all filtered out disappears from the
  // chart rather than leaving a gap.
  // ---------------------------------------------------------------------------
  "lanes": [
    ["h2"],
    ["n2"],
    ["co2"],
    ["co"],
    ["ch4"],
    ["co_metal"],
    ["co_cation"],
    ["carbonyl"],
    ["carbonate"],
    ["bicarbonate"],
    ["formate"],
    ["methoxy"],
    ["methanol_product"],
    ["water"],
    ["hydride"],
    ["support_oh"],
    ["support"],
    ["alumina"],
    ["silica"],
    ["indium_oxide"],
    ["titania"]
  ],

  // ---------------------------------------------------------------------------
  // Sets — named selections of groups, for the chart's filter.
  // A set is an editorial statement about which families belong to one
  // question, so it lives with the data rather than in the frontend. The
  // filter offers "All groups" on top of these; that one is built in and is
  // not listed here.
  //   label, note, groups[] — what the filter shows, one sentence on what the
  //                  set leaves out, and the groups it turns on.
  //   phases[]     — optional. When given, the set also keeps only bands of
  //                  these phases (gas | adsorbed | surface | solution | solid); a band with no
  //                  phase applies to both forms and always stays. Use it
  //                  where a group holds both the free molecule and its
  //                  adsorbed form, as co2 and methanol_product do.
  // ---------------------------------------------------------------------------
  "sets": {
    "co2_hydrogenation": {
      "label": "IR: CO₂ hydrogenation",
      "note": "Everything the CO₂-to-oxygenates/RWGS/methanation story touches.",
      "groups": [
        "formate", "carbonate", "bicarbonate",
        "methoxy", "methanol_product", "co2", "co", "ch4",
        "co_metal", "co_cation"
      ]
    },
    "co2_hydrogenation_extended": {
      "label": "IR: CO₂ hydrogenation (extended)",
      "note": "Everything the CO₂-to-oxygenates/RWGS/methanation story touches.",
      "groups": [
        "water", "formate", "carbonate", "bicarbonate",
        "methoxy", "methanol_product", "co2", "co", "ch4",
        "co_metal", "co_cation", "hydride"
      ]
    },
    "co2_hydrogenation_rwgs_ch4": {
      "label": "IR: CO₂ to CO/CH₄",
      "note": "Everything the RWGS and CO₂ methanation story touches.",
      "groups": [
        "carbonate", "bicarbonate",
        "co2", "co", "ch4", "co_metal", "co_cation"
      ]
    },
    "co_methanation": {
      "label": "IR: CO methanation",
      "note": "Everything the CO₂ methanation story touches.",
      "groups": [
        "carbonate", "bicarbonate",
        "co", "ch4", "co_metal", "co_cation"
      ]
    },
    "adsorbed": {
      "label": "IR: Adsorbed & surface species",
      "note": "Everything that only exists because there is a solid under it.",
      "groups": [
        "support_oh", "support", "alumina", "silica", "hydride",
        "formate", "carbonate", "bicarbonate", "carbonyl", "methoxy",
        "co_metal", "co_cation",
        "co2", "methanol_product"
      ],
      "phases": ["adsorbed", "surface", "solid"]
    },
    "fluids": {
      "label": "Raman: Gases + Fluids",
      "note": "The free molecules only: reactants and products as gas or fluid, dissolved ones included, no surface species. Their adsorbed bands are left out too.",
      "groups": ["co2", "co", "ch4", "h2", "n2", "methanol_product", "water"],
      "phases": ["gas", "solution"]
    },
    "co2_oxides": {
      "label": "Raman: CO₂ with Al₂O₃ and SiO₂",
      "note": "CO₂ beside the lattice lines of the two oxides most often in the beam with it, as a support, a bed or a window; every other family is left out.",
      "groups": ["co2", "alumina", "silica"]
    },
    "raman_oxides": {
      "label": "Raman: Oxides",
      "note": "The lattice lines of the oxides themselves, the specimen rather than anything on it: alumina, silica, indium oxide and titania.",
      "groups": ["alumina", "silica", "indium_oxide", "titania"]
    }
  },

