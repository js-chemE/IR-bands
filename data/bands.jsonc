      "color": "#0186AE"
    },
    "n2": {
      "label": "N₂",
      "color": "#3F4245"
    },
    "co_metal": {
      "label": "CO* on M⁰",
      "color": "#624915"
    },
    "co_cation": {
      "label": "CO* on Mⁿ⁺",
      "color": "#CFA44B"
    },
    "support": {
      "label": "Oxide",
      "color": "#5C5C5C",
      "of": "specimen"
    },
    "alumina": {
      "label": "Al₂O₃",
      "color": "#8A8F9C",
