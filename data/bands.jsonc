    // ---------------------------------------------------------------------------
    // GAS-PHASE WATER
    // Free H₂O(g) fundamentals (C2v) — RWGS byproduct before it condenses/adsorbs;
    // see ADSORBED WATER below for the broadened, merged surface-phase bands.
    // ---------------------------------------------------------------------------
    {
      "id": "h2og_sym",
      "species": "water",
      "phase": "gas",
      "group": "water",
      "vibration_modes": ["h2o_stretch_symmetric"],
      "vibration": {
        "category": "stretch",
        "subtype": "symmetric",
        "branch": null
      },
      "atoms": "H-O-H",
      "wn_start": 3650,
      "wn_end": 3660,
      "short": "νₛ(HOH) H₂O",
      "description": "Gas-phase water symmetric O-H stretch (ν₁, A₁): both O-H bonds lengthening and shortening together, in phase. The number is the band origin, not the feature you see. Water is a light asymmetric top with widely spaced rotational levels, so each fundamental is a rovibrational envelope hundreds of cm⁻¹ across, built from sharp individual lines: the sharpness belongs to the lines, the band is wide. It overlaps ν₃ throughout, and the two are separable only by line position. Adsorbed or condensed water loses the rotation and gives one broad merged feature instead (see oh_surface).",
      "based_on": [],
      "references": [
        {
          "id": 338,
          "key": "Shimanouchi.TablesMolecularVibrational.1972",
          "wn": 3657,
          "technique": "transmission",
          "medium": "gas",
          "form": "free",
          "note": "Table No. 4, water H₂O, C₂ᵥ: selected value 3657 cm⁻¹ for ν₁ sym stretch, with uncertainty code A, the compilation's best grade at 0 to 1 cm⁻¹. The gas-phase infrared column gives 3656.65 cm⁻¹. The Raman column gives 3654 cm⁻¹ for the same mode.",
          "tags": []
        },
        {
          "id": 339,
          "key": "Kojima.QuantitativeAnalysisSpectral.2005",
          "wn": 3657,
          "technique": "srs",
          "laser_nm": 532,
          "medium": "gas",
          "form": "free",
          "note": "Sect. 2.1.2 and Fig. 7: the water-vapour Raman spectrum runs from 3400 to 4130 cm⁻¹ and results mainly from the OH-stretch vibrational modes; 3657 cm⁻¹ is the value assigned to ν₀ for the H₂O Q-branch line-shape diagram, the same figure the compilation gives above. Water is an asymmetric top, for which there are no closed formulae for the rotational terms, and the paper models the region as one unresolved envelope rather than separating ν₁ from ν₃: the number is filed here on the value quoted, not on a resolved band. Measured in a 10 atm H₂-air flame at 1133 K. The paper names only a pulsed Nd:YAG and never states the line; 532 nm is inferred from its own figure axes.",
