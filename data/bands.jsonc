      "color": "#184E37"
    },
    "methanol_product": {
      "label": "MeOH",
      "color": "#02985F"
    },
    "co2": {
      "label": "CO₂",
      "color": "#1E485C"
    },
    "co": {
      "label": "CO",
      "color": "#BA8904"
    },
    "ch4": {
      "label": "CH₄",
      "color": "#C44036"
    },
    "h2": {
