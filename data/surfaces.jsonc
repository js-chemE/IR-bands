      "label": "Zn²⁺",
      "level": "site",
      "kind": "cation",
      "element": "Zn",
      "oxidation_state": 2
    },
    "zr_4p": {
      "label": "Zr⁴⁺",
      "level": "site",
      "kind": "cation",
      "element": "Zr",
      "oxidation_state": 4
    },
    "br_1m": {
      "label": "Br⁻",
      "level": "site",
      "kind": "anion",
      "element": "Br",
      "oxidation_state": -1,
      "note": "The bromide of KBr."
    },
    "o_2m": {
      "label": "O²⁻",
      "level": "site",
      "kind": "anion",
      "element": "O",
      "oxidation_state": -2,
      "note": "A lattice oxide anion, the O of every oxide component. The basic half of a cation-anion pair; heterolytic H₂ splitting and carbonate formation both start on it."
    },
    "h_bronsted": {
      "label": "H⁺",
      "level": "site",
      "kind": "bronsted",
      "element": "H",
      "note": "A proton-donating surface hydroxyl, as opposed to the Lewis-acidic cations above."
    },
    "sioh": {
      "label": "Si–OH",
      "level": "site",
      "kind": "hydroxyl",
      "elements": ["Si", "O", "H"],
      "note": "A silanol, the hydroxyl that terminates a silica surface. Recorded so the Ag⁰-SiO₂ perimeter can name a site on the silica side rather than the whole oxide."
    },
    "ga_oct": {
      "label": "Ga³⁺(o)",
      "level": "site",
      "refines": "ga_3p",
      "coordination": "octahedral",
      "note": "Octahedrally coordinated gallium, the Ga³⁺(o) of β-Ga₂O₃, its charge inherited from Ga³⁺. Coordinatively unsaturated at the surface, which is why it, and not the saturated tetrahedral site, is where H₂ dissociates in the calculations."
    },
    "ga_tet": {
      "label": "Ga³⁺(t)",
      "level": "site",
      "refines": "ga_3p",
      "coordination": "tetrahedral",
      "note": "Tetrahedrally coordinated gallium, the Ga³⁺(t) of β-Ga₂O₃, its charge inherited from Ga³⁺. Its hydride and hydroxyl sit about 25 and 150 cm⁻¹ above those of the octahedral site, which is how the two are told apart."
    },
    "o_vac": {
      "label": "Vₒ",
      "level": "site",
      "kind": "defect",
      "note": "A bare oxygen vacancy. Listed on its own so ensembles can point at it."
    },
    "o_vac_1p": {
      "label": "Vₒ⁺",
      "level": "site",
      "refines": "o_vac",
      "kind": "defect",
      "charge": 1,
      "note": "An oxygen vacancy that has given up one of its two electrons, the donor centre whose photoionization to the conduction band is the broad electronic absorption under an operando Cu/ZnO spectrum. Its concentration, not just its existence, is what the band measures."
    },
    "zn_ovac_hf": {
      "label": "Zn–Vₒ–Hf",
      "level": "site",
      "kind": "defect",
      "parts": ["zn_2p", "o_vac", "hf_4p"],
      "note": "An oxygen vacancy flanked by Zn and Hf: the two cations and the vacancy act as one site."
    },
    "ag_sio2_interface": {
      "label": "Ag⁰-SiO₂ perimeter",
      "level": "site",
      "kind": "interface",
      "parts": ["ag_0", "sioh"],
      "note": "The rim where a silver nanoparticle meets the silica, named as the active site for methyl formate: the formate sits on the metal and the carbonic acid and adsorbed methanol on the silica beside it, so the esterification happens where the two meet rather than on either alone."
    },
    "pt0_ceo2_interface": {
      "label": "Pt⁰-CeO₂ perimeter",
      "level": "site",
      "kind": "interface",
      "parts": [
        "pt_0",
        "ce_4p",
        "ce_3p",
        "o_2m",
        "o_vac"
      ],
      "note": "The perimeter where Pt particles meet ceria: Pt⁰ on one side, the ceria lattice on the other, Ce⁴⁺ and O²⁻, and under reduction Ce³⁺ beside oxygen vacancies (2 Ce⁴⁺ + O²⁻ → 2 Ce³⁺ + Vₒ + ½ O₂, eased by hydrogen spilling over from the metal). Vico van Berkel and Urakawa write of a highly reduced ceria surface and of oxygen vacancies; Ce³⁺ is the author's reading of that phrase, the standard one."
    },

    // ── Materials, one compound each: made of their ions ──
    "al2o3": {
      "label": "Al₂O₃",
      "level": "material",
      "kind": "oxide",
      "formula": "Al₂O₃",
      "parts": ["al_3p", "o_2m"]
    },
    "ceo2": {
      "label": "CeO₂",
      "level": "material",
      "kind": "oxide",
      "formula": "CeO₂",
      "parts": ["ce_4p", "o_2m"]
    },
    "fe2o3": {
      "label": "Fe₂O₃",
      "level": "material",
      "kind": "oxide",
      "formula": "Fe₂O₃",
      "parts": ["fe_3p", "o_2m"]
    },
    "fe3o4": {
      "label": "Fe₃O₄",
      "level": "material",
      "kind": "oxide",
      "formula": "Fe₃O₄",
      "parts": ["fe_2p", "fe_3p", "o_2m"],
      "note": "Magnetite with no termination stated. The two facet variants below point at it, and all three are the same compound: only the cut differs."
    },
    "fe3o4_001": {
      "label": "Fe₃O₄(001)",
      "level": "material",
      "refines": "fe3o4",
      "facet": "(001)",
      "note": "Magnetite cut on the (001) plane. Magnetite is an inverse spinel, Fe³⁺ on the tetrahedral sites and Fe²⁺ and Fe³⁺ on the octahedral ones, and this face is commonly described as ending in a layer of octahedral iron and oxygen, reconstructed (√2×√2)R45° by an ordered array of cation vacancies just beneath it. A refinement of Fe₃O₄ by its facet: the cut is a termination, not a composition, so a search for Fe₃O₄ finds it and a search for the (001) cut finds only it."
    },
    "fe3o4_111": {
      "label": "Fe₃O₄(111)",
      "level": "material",
      "refines": "fe3o4",
      "facet": "(111)",
      "note": "Magnetite cut on the (111) plane, parallel to the close-packed oxygen layers of the spinel. The termination depends on preparation and is still debated; the one most often reported is a quarter monolayer of tetrahedral iron above a close-packed oxygen layer. It is kept apart from Fe₃O₄(001) because the two cuts expose different Fe spacings and carry different formate geometries: a structural difference, not a compositional one. A refinement of Fe₃O₄ by its facet, so a search for Fe₃O₄ finds it."
    },
    "ga2o3": {
      "label": "Ga₂O₃",
      "level": "material",
      "kind": "oxide",
      "formula": "Ga₂O₃",
      "parts": ["ga_3p", "o_2m"],
      "note": "Gallia, as a component of a promoted catalyst and as a specimen in its own right. Made of Ga³⁺ and O²⁻. The β polymorph carries tetrahedral and octahedral gallium, which is why hydride and hydroxyl bands on it come in pairs; those two are refinements of Ga³⁺, named on a claim only where the paper resolves the coordination."
    },
    "hfo2": {
      "label": "HfO₂",
      "level": "material",
      "kind": "oxide",
      "formula": "HfO₂",
      "parts": ["hf_4p", "o_2m"],
      "note": "Hafnia, ZrO₂'s chemical twin. Monoclinic when precipitated and calcined on its own; the Zn-doped solid solutions are cubic and are the znhfox specimen, not this."
    },
    "kbr": {
      "label": "KBr",
      "level": "material",
      "kind": "halide",
      "formula": "KBr",
      "parts": ["k_1p", "br_1m"],
      "note": "Potassium bromide, the infrared-transparent salt a powder is diluted in for DRIFTS or pressed into for a pellet. Named only as a diluent on a claim, never as a part of a catalyst."
    },
    "moo3": {
      "label": "MoO₃",
      "level": "material",
      "kind": "oxide",
      "formula": "MoO₃",
      "parts": [
        "mo_6p",
        "o_2m"
      ],
      "note": "Molybdenum trioxide, all Mo⁶⁺: the crystalline phase XRD shows on an unreduced MoO₃/TiO₂, and the parent of the reduced MoOₓ."
    },
    "moox": {
      "label": "MoOₓ",
      "level": "material",
      "refines": "moo3",
      "stoichiometry": "reduced, O-deficient",
      "parts": [
        "mo_5p",
        "mo_4p",
        "mo_dp",
        "o_vac"
      ],
      "note": "Molybdenum oxide reduced below MoO₃, a refinement of MoO₃ by its stoichiometry as ZnO₁₋ₓ is of ZnO: the reduced, oxygen-deficient state is the point, and its vacancies are what CO₂ re-oxidises. Not a mixture of MoO₃ and MoO₂ phases: on Pt/MoOₓ/TiO₂ the MoO₃ reflections fade on reduction and no crystalline Mo oxide is left (Toyao). The reduced cations Mo⁵⁺, Mo⁴⁺ and Moᵟ⁺ are the general MoOₓ literature's; Toyao's XANES shows only that Mo is reduced below Mo⁶⁺."
    },
    "nial2o4": {
      "label": "NiAl₂O₄",
      "level": "material",
      "kind": "mixed oxide",
      "formula": "NiAl₂O₄",
      "parts": ["ni_2p", "al_3p", "o_2m"],
      "note": "Nickel aluminate spinel, formed where Ni reacts with an alumina support on calcination; harder to reduce than NiO."
    },
    "nio": {
      "label": "NiO",
      "level": "material",
      "kind": "oxide",
      "formula": "NiO",
      "parts": ["ni_2p", "o_2m"],
      "note": "Nickel oxide, the phase a calcined Ni catalyst carries before it is reduced to the metal."
    },
    "sio2": {
      "label": "SiO₂",
      "level": "material",
      "kind": "oxide",
      "formula": "SiO₂",
      "parts": ["si_4p", "o_2m", "sioh"]
    },
    "sio2_fumed": {
      "label": "fumed SiO₂",
      "level": "material",
      "refines": "sio2",
      "form": "fumed powder (amorphous)",
      "note": "Amorphous fumed silica (Cab-O-Sil, Aerosil), the high-area powder used as a catalyst support."
    },
    "sio2_glass": {
      "label": "SiO₂ glass",
      "level": "material",
      "refines": "sio2",
      "form": "vitreous (glass)",
      "note": "Vitreous silica, v-SiO₂: a dense glass, here sintered from fumed silica or melted, rather than a high-area powder."
    },
    "sio2_cristobalite": {
      "label": "β-cristobalite",
      "level": "material",
      "refines": "sio2",
      "polymorph": "β-cristobalite",
      "note": "The high-temperature cristobalite polymorph of silica, which a silica glass starts to crystallise into when sintered near 1450 °C."
    },
    "sio2_quartz": {
      "label": "α-quartz",
      "level": "material",
      "refines": "sio2",
      "polymorph": "α-quartz",
      "note": "The common crystalline polymorph of silica, which turns into the closely related β-quartz above about 900 K."
    },
    "sno2": {
      "label": "SnO₂",
      "level": "material",
      "kind": "oxide",
      "formula": "SnO₂",
      "parts": ["sn_4p", "o_2m"],
      "note": "Tin dioxide, the classic oxide cathode for CO₂ reduction to formate. Under strongly cathodic potentials it is not stable: a Pourbaix analysis at pH 6.8 puts metallic Sn as the stable phase near −1.1 V vs. RHE, so the entry names what was put in the cell, not what the surface is during reduction."
    },
    "tio2": {
      "label": "TiO₂",
      "level": "material",
      "kind": "oxide",
      "formula": "TiO₂",
      "parts": ["ti_4p", "o_2m"]
    },
    "tio2_anatase": {
      "label": "anatase TiO₂",
      "level": "material",
      "refines": "tio2",
      "polymorph": "anatase",
      "note": "Anatase, the tetragonal TiO₂ polymorph (I4₁/amd) that low-temperature syntheses and most catalyst supports give. It converts irreversibly to rutile on heating, in fine powders from about 600 to 750 °C rather than the 900 °C and more of single crystals."
    },
    "tio2_rutile": {
      "label": "rutile TiO₂",
      "level": "material",
      "refines": "tio2",
      "polymorph": "rutile",
      "note": "Rutile, the tetragonal TiO₂ polymorph (P4₂/mnm) that is stable at every temperature and the one anatase turns into on heating."
    },
    "zno": {
      "label": "ZnO",
      "level": "material",
      "kind": "oxide",
      "formula": "ZnO",
      "parts": ["zn_2p", "o_2m"]
    },
    "zno_1mx": {
      "label": "ZnO₁₋ₓ",
      "level": "material",
      "refines": "zno",
      "stoichiometry": "O-deficient",
      "parts": ["o_vac", "o_vac_1p"],
      "note": "Zinc oxide that has lost lattice oxygen under reduction, a refinement of ZnO by its stoichiometry: it is still ZnO, with oxygen vacancies added to its parts. A search for ZnO finds it."
    },
    "zro2": {
      "label": "ZrO₂",
      "level": "material",
      "kind": "oxide",
      "formula": "ZrO₂",
      "parts": ["zr_4p", "o_2m"]
    },
    "al2o3_alpha": {
      "label": "α-Al₂O₃",
      "level": "material",
      "refines": "al2o3",
      "polymorph": "α",
      "note": "Corundum, the low-area thermodynamically stable alumina, used as a reference oxide or as an inert diluent."
    },
    "in2o3": {
      "label": "In₂O₃",
      "level": "material",
      "kind": "oxide",
      "formula": "In₂O₃",
      "parts": ["in_3p", "o_2m"],
      "note": "Indium oxide, the reducible oxide whose oxygen vacancies are the methanol-synthesis sites on In₂O₃ catalysts."
    },
    "in2o3_c": {
      "label": "c-In₂O₃",
      "level": "material",
      "refines": "in2o3",
      "polymorph": "cubic (bixbyite)",
      "note": "Cubic bixbyite In₂O₃ (PDF 06-0416), the stable polymorph and the one precipitation and calcination give."
    },
    "sapphire": {
      "label": "Sapphire",
      "level": "material",
      "refines": "al2o3_alpha",
      "form": "single crystal",
      "note": "α-Al₂O₃ grown as one crystal: a window, a rod or a substrate rather than a powder. A refinement of α-Al₂O₃ by form, because a single crystal's Raman lines are sharp and their relative intensities depend on how the crystal is turned to the laser, which a powder averages away. Which axis faced the laser, where a paper gives it, goes in the claim's note: it moves no line."
    },
    "al2o3_gamma": {
      "label": "γ-Al₂O₃",
      "level": "material",
      "refines": "al2o3",
      "polymorph": "γ",
      "note": "Gamma alumina, the high-area transition alumina used as a support; its strongest Lewis sites are coordinatively unsaturated Al³⁺."
    },

    // ── Materials, composite: catalysts, electrodes and models, made of other materials and sites ──

    "ag_au": {
      "label": "Ag/Au on Si",
      "level": "material",
      "parts": ["ag_0", "au_0", "si_0"],
      "note": "Ag/Au deposited on a silicon prism: the layers, whatever shape they were made in. The film electrode is its refinement by form."
    },
    "ag_au_film": {
      "label": "Ag/Au on Si, film electrode",
      "level": "material",
      "refines": "ag_au",
      "form": "film electrode",
      "note": "A SEIRAS working electrode: a chemically deposited Au film of about 60 nm on a Si prism, with Ag electrodeposited over it. The silver is what faces the electrolyte, so it is the only site listed; the gold is an underlayer that carries the surface enhancement, and the silicon is the prism the beam comes through, which is optics rather than catalyst and is left out of the elements."
    },
    "ag_sio2": {
      "label": "Ag/SiO₂",
      "level": "material",
      "parts": ["ag_0", "sio2", "ag_sio2_interface"],
      "note": "Silver nanoparticles under 11 nm at 1 wt % on a 155 m² g⁻¹ silica, by wetness impregnation. Silica is chosen as a neutral support so the metal is what differs; it makes no methyl formate without the metal present."
    },
    "au_si": {
      "label": "Au on Si",
      "level": "material",
      "parts": ["au_0", "si_0"],
      "note": "Au deposited on a silicon prism: the layers, whatever shape they were made in. The film electrode is its refinement by form."
    },
    "au_film": {
      "label": "Au on Si, film electrode",
      "level": "material",
      "refines": "au_si",
      "form": "film electrode",
      "note": "A chemically deposited Au film of about 60 nm on a Si prism, the underlayer the Ag, Cu and SnO₂ SEIRAS electrodes are built on, measured bare as a control. The silicon prism is optics, not catalyst."
    },
    "au_ag_silicalite": {
      "label": "Au-Ag/silicalite-1",
      "level": "material",
      "parts": ["au_0", "au_1p", "ag_0", "ag_1p", "sio2"],
      "note": "Gold and silver nanoparticles embedded in silicalite-1, the all-silica MFI zeotype. Recorded with sio2 as its component rather than with zsm5: silicalite-1 has no aluminium and therefore none of the exchange sites that make ZSM-5 what it is."
    },
    "au_sio2": {
      "label": "Au/SiO₂",
      "level": "material",
      "parts": ["au_0", "sio2"],
      "note": "Gold nanoparticles under 11 nm at 1 wt % on silica, prepared alongside the Cu and Ag counterparts so the three coinage metals can be compared on one support."
    },
    "co_al2o3": {
      "label": "Co/Al₂O₃",
      "level": "material",
      "parts": ["co_0", "al2o3_gamma"],
      "note": "14% Co on γ-alumina (85 m² g⁻¹, calcined at 500 °C), prepared after Shi et al. with citric acid, as Paredes-Nunez et al. describe it."
    },
    "co_siralox": {
      "label": "Co/Siralox",
      "level": "material",
      "parts": ["co_0", "al2o3", "si_4p"],
      "note": "Cobalt on Siralox, a commercial silica-alumina of 5% SiO₂ and 95% Al₂O₃. Kept apart from co_al2o3: the support differs, and so does the carbonyl position reported on it. SiO₂ is not listed as a component: at 5% it dopes the alumina rather than forming a phase of its own, so the part is the Si⁴⁺ site. The paper names no alumina phase, so the support is plain Al₂O₃."
    },
    "cu_gazrox": {
      "label": "Cu-GaZrOₓ",
      "level": "material",
      "parts": ["cu_0", "cu_1p", "gazrox"],
      "note": "Coprecipitated Cu-Ga-Zr mixed oxide, around 20 wt% Cu. Sources publish it as a series with different Ga and Zr loadings, written Cu-GaZrOₓ-Z where Z is Zr/(Zr+Cu+Ga) as a molar percentage; the family is recorded here and the individual member named in the note, since the distinction the spectra turn on is against the Cu-free GaZrOₓ rather than between members."
    },
    "cuga_sio2": {
      "label": "Cu-Ga₂O₃/SiO₂",
      "level": "material",
      "parts": ["cu_0", "cu_1p", "cu_2p", "ga2o3", "sio2"],
      "note": "Ga₂O₃-promoted Cu on silica, published as a loading series written CuGa(x) where x is the Ga/(Cu+Ga) molar ratio. The family is recorded here and the member named in the note, because the distinction the spectra turn on is against the Ga-free cu_sio2 rather than between members: the Cu⁺ carbonyl is absent without Ga and its area grows with the loading."
    },
    "cu_zsm5": {
      "label": "Cu-ZSM-5",
      "level": "material",
      "parts": [
        "h_zsm5",
        "cu_1p"
      ],
      "note": "Copper-exchanged ZSM-5, reduced in CO before adsorption to raise the share of Cu⁺. Built on H-ZSM-5: Zdravkova et al. calcine NH₄-ZSM-5 (Si/Al 25) and exchange copper into it, and at about 1 wt% Cu most framework charges are still balanced by protons, whose bridging hydroxyls the spectra show. Their aluminol band at 3664 cm⁻¹ points to some extra-framework alumina as well, not listed as a part while no claim turns on it."
    },
    "cu_au": {
      "label": "Cu/Au on Si",
      "level": "material",
      "parts": ["cu_0", "au_0", "si_0"],
      "note": "Cu/Au deposited on a silicon prism: the layers, whatever shape they were made in. The film electrode is its refinement by form."
    },
    "cu_au_film": {
      "label": "Cu/Au on Si, film electrode",
      "level": "material",
      "refines": "cu_au",
      "form": "film electrode",
      "note": "A SEIRAS working electrode: a chemically deposited Au film of about 60 nm on a Si prism, with Cu electrodeposited over it, roughly 150 monolayers. The copper is what faces the electrolyte, so it is the only site listed; the gold underlayer carries the enhancement and should not be exposed, which a CO band above 2100 cm⁻¹ (CO on Au) would reveal. The silicon prism is optics, not catalyst."
    },
    "cu_sio2": {
      "label": "Cu/SiO₂",
      "level": "material",
      "parts": ["cu_0", "sio2"],
      "note": "Copper on silica with no promoter. Silica is close to inert here, so this is the reference against which a promoter's effect is read, and it is listed with Cu⁰ alone: the sources that pair it with a promoted counterpart find no Cu⁺ carbonyl on it at all."
    },
    "cu_zno": {
      "label": "Cu/ZnO",
      "level": "material",
      "parts": ["cu_0", "cu_1p", "zno", "zno_1mx"]
    },
    "cu_zro2": {
      "label": "Cu/ZrO₂",
      "level": "material",
      "parts": ["cu_0", "zro2"],
      "note": "Copper on monoclinic zirconia by incipient wetness, 6 wt% Cu, calcined at 450 °C and reduced in situ at 350 °C. The zirconia carries about 93 % of the surface area, which is why almost every band on it is a zirconia band and why the copper-bound formate had to be dug out of a difference spectrum."
    },
    "cuga_sio2_somc": {
      "label": "CuGa/SiO₂",
      "level": "material",
      "parts": ["cu_0", "ga_3p", "sio2"],
      "note": "Cu nanoparticles on silica decorated with isolated Ga³⁺ sites, made by surface organometallic chemistry: 3.88 wt% Cu, 1.61 wt% Ga, Ga/Cu 0.40. A different material from cuga_sio2, which carries a Ga₂O₃ phase: here the gallium is single cations, fully re-oxidised under reaction, with no oxide phase."
    },
    "cuin_sio2": {
      "label": "CuIn/SiO₂",
      "level": "material",
      "parts": ["cu_0", "in_3p", "sio2"],
      "note": "Cu nanoparticles on silica decorated with isolated In³⁺ sites, made by surface organometallic chemistry: 3.81 wt% Cu, 1.82 wt% In, In/Cu 0.26. About a third of the In alloys with Cu after reduction and re-oxidises to In³⁺ under reaction; no In₂O₃ phase."
    },
    "cuzn_sio2": {
      "label": "CuZn/SiO₂",
      "level": "material",
      "parts": ["cu_0", "zn_2p", "sio2"],
      "note": "Cu nanoparticles on silica decorated with isolated Zn²⁺ sites, made by surface organometallic chemistry: 4.16 wt% Cu, 1.62 wt% Zn, Zn/Cu 0.40. There is no ZnO phase, which is the point of the material: the Zn is single cations at the Cu interface, partly alloyed after reduction and partly re-oxidised under reaction, so it is listed as Zn²⁺ and not as ZnO."
    },
    "gazrox": {
      "label": "GaZrOₓ",
      "level": "material",
      "kind": "mixed oxide",
      "parts": ["ga_3p", "zr_4p", "o_2m"],
      "note": "The Cu-free counterpart of the Cu-GaZrOₓ series, 48 wt% Ga and 25 wt% Zr. Run to separate what the oxide does from what Cu does."
    },
    "la_al2o3": {
      "label": "La-Al₂O₃",
      "level": "material",
      "parts": ["al2o3_gamma", "la_3p"],
      "note": "γ-alumina (SASOL) impregnated with lanthanum and calcined, 6 wt% La in the Rajput series: La³⁺ dispersed in the alumina as a stabiliser, not a phase of its own."
    },
    "ni_ce_fe_la_al2o3": {
      "label": "Ni-Ce-Fe/La-Al₂O₃",
      "level": "material",
      "parts": ["la_al2o3", "nio", "nial2o4", "fe2o3", "ceo2"],
      "note": "40Ni₀.₇₅(Ce₀.₇₅Fe₀.₂₅)₀.₂₅/6La-Al₂O₃ as measured by DRIFTS: fresh, purged in N₂ at 300 °C and not reduced before the CO₂/CH₄ feed at 600 °C. Its XRD shows NiO, NiAl₂O₄ and CeO₂, and Fe₂O₃ as a dispersed, nearly amorphous oxide, so those are its components."
    },
    "pd_al2o3": {
      "label": "Pd/Al₂O₃",
      "level": "material",
      "parts": ["pd_0", "al2o3"],
      "note": "Palladium on alumina, the monometallic reference against which the Sn- and Zn-modified counterparts are read: it is the one that still has Pd-Pd pairs, so it is the one that still shows bridged CO. The review names no alumina phase, so the support is plain Al₂O₃."
    },
    "pt_ceo2": {
      "label": "Pt/CeO₂",
      "level": "material",
      "parts": [
        "pt_0",
        "ceo2",
        "pt0_ceo2_interface"
      ],
      "note": "3 wt% Pt on ceria by incipient wetness impregnation with Pt(NH₃)₄(NO₃)₂, calcined at 500 °C and reduced in H₂ at 300 °C, as Vico van Berkel and Urakawa use it for the reverse water–gas shift. The Pt-ceria perimeter is a part of its own, being where that paper places its carbonyls."
    },
    "pt_moox_tio2": {
      "label": "Pt/MoOₓ/TiO₂",
      "level": "material",
      "parts": ["pt_0", "moox", "tio2"],
      "note": "Platinum on a molybdenum-oxide-covered titania, made by sequential impregnation and reduced in H₂ at 300 °C. Both metals are needed: neither Pt on bare TiO₂ nor MoOₓ/TiO₂ alone gives the methanol yield, which is what the specimen entry is here to keep together."
    },
    "ru_na2o_al2o3": {
      "label": "Ru/\"Na₂O\"/Al₂O₃",
      "level": "material",
      "parts": ["ru_0", "al2o3_gamma", "na_1p"],
      "note": "The sodium-promoted counterpart of Ru/Al₂O₃ on the same γ-Al₂O₃ (SBA-150); the quotes are the authors’ own, since the \"Na₂O\" is in fact Na⁺ in surface aluminate species."
    },
    "ru_al2o3": {
      "label": "Ru/Al₂O₃",
      "level": "material",
      "parts": ["ru_0", "al2o3_gamma"],
      "note": "5 wt% Ru on high-surface-area γ-Al₂O₃ (SBA-150, BASF), pre-reduced in H₂ at 320 °C: the conventional methanation catalyst Proaño et al. compare their dual-function material against."
    },
    "sno2_au": {
      "label": "SnO₂/Au on Si",
      "level": "material",
      "parts": ["sno2", "au_0", "si_0"],
      "note": "SnO₂/Au deposited on a silicon prism: the layers, whatever shape they were made in. The film electrode is its refinement by form."
    },
    "sno2_au_film": {
      "label": "SnO₂/Au on Si, film electrode",
      "level": "material",
      "refines": "sno2_au",
      "form": "film electrode",
      "note": "A SEIRAS working electrode: commercial SnO₂ nanoparticles (50 to 70 nm) cast onto a chemically deposited Au film on a Si prism. The oxide faces the electrolyte; the gold underneath carries the enhancement. Whether the SnO₂ stays oxide or reduces to Sn under reaction is not settled by the spectra, so no site is listed."
    },
    "znhfox": {
      "label": "ZnHfOₓ",
      "level": "material",
      "kind": "mixed oxide",
      "parts": ["zn_2p", "hf_4p", "o_2m", "zn_ovac_hf"],
      "note": "Co-precipitated Zn–Hf mixed oxide, published as a series written xZnHfOₓ with x the Zn/(Zn+Hf) molar percentage. Up to about 35 mol% it is Zn-doped cubic HfO₂ in solid solution; above 40 mol% bulk ZnO segregates and carries HfOₓ clusters on its surface. One key for the family, with the member named in the note, because the IR bands of both regimes agree within a few wavenumbers and that agreement is the claim the spectra turn on. ZnO is not listed as a part: the low-Zn members contain none."
    },
    "zsm5": {
      "label": "ZSM-5",
      "level": "material",
      "composition": "MₙAlₙSi₉₆₋ₙO₁₉₂",
      "parts": [
        "al_3p",
        "si_4p",
        "o_2m"
      ],
      "note": "The MFI aluminosilicate framework, MₙAlₙSi₉₆₋ₙO₁₉₂ with n below 27: corner-sharing SiO₄ and AlO₄⁻ tetrahedra in one crystalline phase, not Al₂O₃ + SiO₂, which is only the way its composition is sometimes written. Each framework Al carries a negative charge balanced by an extra-framework cation M, and which cation that is is a refinement of its own (H-ZSM-5, Na-ZSM-5, …), named on the claim where the paper names it. The Si/Al ratio goes in the claim's note while no band turns on it."
    },
    "h_zsm5": {
      "label": "H-ZSM-5",
      "level": "material",
      "refines": "zsm5",
      "form": "H-form",
      "composition": "HₙAlₙSi₉₆₋ₙO₁₉₂",
      "parts": [
        "h_bronsted"
      ],
      "note": "The proton form, usually made by calcining NH₄-ZSM-5: the charge of each framework Al is balanced by a proton on a bridging Si-(OH)-Al hydroxyl, near 3610 cm⁻¹, the Brønsted acid site. A refinement of ZSM-5 by its counter-cation, so a search for ZSM-5 finds it."
    },
    "li_zsm5": {
      "label": "Li-ZSM-5",
      "level": "material",
      "refines": "zsm5",
      "form": "Li-form",
      "composition": "LiₙAlₙSi₉₆₋ₙO₁₉₂",
      "parts": [
        "li_1p"
      ],
      "note": "ZSM-5 exchanged with Li⁺, the smallest and most polarising of the alkali cations. A refinement of ZSM-5 by its counter-cation, so a search for ZSM-5 finds it."
    },
    "na_zsm5": {
      "label": "Na-ZSM-5",
      "level": "material",
      "refines": "zsm5",
      "form": "Na-form",
      "composition": "NaₙAlₙSi₉₆₋ₙO₁₉₂",
      "parts": [
        "na_1p"
      ],
      "note": "ZSM-5 with Na⁺ as the extra-framework cation, the as-synthesised form. A refinement of ZSM-5 by its counter-cation, so a search for ZSM-5 finds it."
    },
    "k_zsm5": {
      "label": "K-ZSM-5",
      "level": "material",
      "refines": "zsm5",
      "form": "K-form",
      "composition": "KₙAlₙSi₉₆₋ₙO₁₉₂",
      "parts": [
        "k_1p"
      ],
      "note": "ZSM-5 exchanged with K⁺. A refinement of ZSM-5 by its counter-cation, so a search for ZSM-5 finds it."
    },
    "rb_zsm5": {
      "label": "Rb-ZSM-5",
      "level": "material",
      "refines": "zsm5",
      "form": "Rb-form",
      "composition": "RbₙAlₙSi₉₆₋ₙO₁₉₂",
      "parts": [
        "rb_1p"
      ],
      "note": "ZSM-5 exchanged with Rb⁺. A refinement of ZSM-5 by its counter-cation, so a search for ZSM-5 finds it."
    },
    "cs_zsm5": {
      "label": "Cs-ZSM-5",
      "level": "material",
      "refines": "zsm5",
      "form": "Cs-form",
      "composition": "CsₙAlₙSi₉₆₋ₙO₁₉₂",
      "parts": [
        "cs_1p"
      ],
      "note": "ZSM-5 exchanged with Cs⁺, the largest and least polarising of the alkali cations. A refinement of ZSM-5 by its counter-cation, so a search for ZSM-5 finds it."
    }
  }
}
