    },
    "si_4p": {
      "label": "Si⁴⁺",
      "level": "site",
      "kind": "cation",
      "element": "Si",
      "oxidation_state": 4,
      "note": "The silicon of a silica or silicate network, written as the cation it formally is. Too shielded to bind most adsorbates itself; the silanol beside it does."
    },
    "sn_4p": {
      "label": "Sn⁴⁺",
      "level": "site",
      "kind": "cation",
      "element": "Sn",
      "oxidation_state": 4,
