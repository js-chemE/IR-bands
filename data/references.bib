	doi = {10.1021/jp9933121},
	shorttitle = {Vibrational Analysis of a Chemisorbed Polyatomic Molecule},
	abstract = {Infrared reflection absorption spectra were obtained from 900 to 3000 cm-1 for five C3v symmetry isotopomers of methoxy:  H312C16O, H313C16O, H312C18O, D312C16O, D313C16O; and two Cs symmetry isotopomers:  {DH}212C16O, and {HD}212C16O. Measured frequencies of the five C3v isotopomers were used to derive an empirical valence force field based on a C3v symmetry H3COCu3 model. Without further adjustment, this force field was used to calculate the harmonic frequencies of the two Cs symmetry isotopomers which were found to be in good agreement with the experimental frequencies. Comparison of a Cs symmetry H3COCu12 model with an adsorption site structure that accurately models the experimentally determined geometry, as well as with a C3v symmetry H3COCu model, shows that the internal vibrations of the methoxy unit are relatively insensitive to the adsorption site. Among other advantages, an accurate description of the normal modes of this molecule provides a quantitative understanding of the unusual intensity patterns in the {CO} stretch and {CH}3 symmetric deformation (δs({CH}3)) region, which leads to an extremely low intensity for the δs({CH}3) fundamental for the H312C16O isotopomer. In addition to the vibrational properties of methoxy that can be understood within the harmonic approximation, two manifestations of anharmonicty are observed:  (1) the position of the overtone of the {CO} stretch; and (2) Fermi resonance in the {CH} stretch region between the symmetric {CH} stretch fundamental and the overtones of the symmetric and asymmetric {CH}3 bends. The normal coordinate analysis allows the position of the unperturbed vibrations in the {CH} stretch region to be more accurately estimated and helps to explain the weaker Fermi resonance in the {CD} stretch region of D3CO. Finally, the empirical valence force field is compared with the force field derived from an ab initio calculation of H3COCu.},
	pages = {2448--2459},
	number = {11},
	journaltitle = {The Journal of Physical Chemistry B},
	shortjournal = {J. Phys. Chem. B},
	publisher = {American Chemical Society},
	author = {Mudalige, Kanchana and Warren, Samantha and Trenary, Michael},
	urldate = {2026-06-22},
	date = {2000-03-01},
	keywords = {reproduced/used-some-number/results},
	file = {Mudalige et al._2000_Vibrational Analysis of a Chemisorbed Polyatomic Molecule  Methoxy on Cu(100).pdf:C\:\\Users\\jsommer1\\OneDrive\\[Literature]\\Mudalige et al._2000_Vibrational Analysis of a Chemisorbed Polyatomic Molecule  Methoxy on Cu(100).pdf:application/pdf},
}

@article{Zdravkova.SurprisingCoordinationChemistry.2015,
	title = {Surprising Coordination Chemistry of Cu+ Cations in Zeolites: {FTIR} Study of Adsorption and Coadsorption of {CO}, {NO}, N2, and H2O on Cu–{ZSM}-5},
	volume = {119},
	issn = {1932-7447},
	url = {https://doi.org/10.1021/acs.jpcc.5b03213},
	doi = {10.1021/acs.jpcc.5b03213},
	shorttitle = {Surprising Coordination Chemistry of Cu+ Cations in Zeolites},
	abstract = {Cations exchanged in zeolites are generally characterized by a low coordination number and can thus attach simultaneously more than one small guest molecule. For instance, Cu+ ions in {ZSM}-5 can accept, at low temperature, up to three {CO} and up to two {NO} molecules. However, only one N2 molecule can be coordinated to such sites. Although mixed aqua-carbonyl and aqua-dinitrogen complexes are formed, no mixed carbonyl-nitrosyl, carbonyl-dinitrogen, or nitrosyl-dinitrogen species can be produced. Thus, adsorption of {NO} on {CO} precovered sample results in segregation of the {CO} adsorption layer according to the reaction: 2Cu+–{CO} + 2NO → Cu+({CO})2 + Cu+({NO})2. Adsorption of N2 on {NO} precovered sample leads to a similar process: 2Cu+–{NO} + N2 → Cu+({NO})2 + Cu+–N2. No carbonyl-dinitrogen complexes are produced during {CO}–N2 coadsorption. The role of the ligand and the nature of the bond in the formation of geminal and mixed-ligand complexes are discussed.},
	pages = {15292--15302},
	number = {27},
	journaltitle = {The Journal of Physical Chemistry C},
	shortjournal = {J. Phys. Chem. C},
	publisher = {American Chemical Society},
	author = {Zdravkova, Videlina and Drenchev, Nikola and Ivanova, Elena and Mihaylov, Mihail and Hadjiivanov, Konstantin},
	urldate = {2026-06-22},
	date = {2015-07-09},
	keywords = {reproduced/used-some-number/results},
	file = {Zdravkova et al._2015_Surprising Coordination Chemistry of Cu+ Cations in Zeolites FTIR Study of Adsorption and Coadsorpt.pdf:C\:\\Users\\jsommer1\\OneDrive\\[Literature]\\Zdravkova et al._2015_Surprising Coordination Chemistry of Cu+ Cations in Zeolites FTIR Study of Adsorption and Coadsorpt.pdf:application/pdf},
}

@article{Ugliengo.QuantumChemicalCalculations.1999,
	title = {Quantum Chemical Calculations and Experimental Evidence for O-Bonding of Carbon Monoxide to Alkali Metal Cations in Zeolites},
	volume = {103},
	issn = {1520-6106},
	url = {https://doi.org/10.1021/jp982078w},
	doi = {10.1021/jp982078w},
	abstract = {By the comparison of experimental results and computational data concerning the interaction of {CO} with one or two naked cations, evidence is provided that weak bands occurring in the {IR} spectra of basic zeolites, after the low-temperature adsorption of {CO}, at frequencies lower than that of the gaseous molecule, are due to species O-bonded to a single cation in thermodynamic equilibrium with the usual, more stable species C-bonded to the same cation. The absence of O-bonding for {CO} in other systems is discussed, and evidence is provided for the probable occurrence in protonic zeolites.},
	pages = {4839--4846},
	number = {23},
	journaltitle = {The Journal of Physical Chemistry B},
	shortjournal = {J. Phys. Chem. B},
	publisher = {American Chemical Society},
